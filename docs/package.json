    "nuxt": "4.6.0",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.138",
    "@iconify-json/simple-icons": "1.2.98",
    "@iconify-json/vscode-icons": "1.2.83",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@11.3.0"
