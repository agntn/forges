    "nuxt": "4.6.1",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.141",
    "@iconify-json/simple-icons": "1.2.99",
    "@iconify-json/vscode-icons": "1.2.86",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@12.11.2"
