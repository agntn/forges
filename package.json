{
  "name": "@agntn/forges",
  "version": "0.1.2",
  "description": "Unified Git Provider - single TypeScript API for GitHub, GitLab, Gitea, and GitBucket",
  "keywords": [
    "api",
    "git",
    "gitbucket",
    "gitea",
    "github",
    "gitlab",
    "mcp",
    "omp-extension",
    "pi-package",
    "provider",
    "unified"
  ],
  "homepage": "https://github.com/agntn/forges#readme",
  "bugs": "https://github.com/agntn/forges/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/forges.git"
  },
  "bin": {
    "forges": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/shared",
    "packages/pi/extensions",
    "packages/omp/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.mts",
      "import": "./dist/gitlab.mjs"
    },
    "./gitea": {
      "types": "./dist/gitea.d.mts",
      "import": "./dist/gitea.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "import": "./dist/provider.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:packed": "node --experimental-strip-types test/eval-packed-extensions.mjs",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "citty": "^0.2.2",
    "ofetch": "^1.3.4",
    "typebox": "1.3.14",
    "unstorage": "^1.10.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/omptype": "17.3.7",
    "@oh-my-pi/pi-coding-agent": "17.3.7",
    "@types/node": "^24.0.0",
    "changelogen": "^0.6.2",
    "obuild": "^0.4.31",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1",
    "@oh-my-pi/pi-coding-agent": ">=17.3.7 <18",
    "typebox": ">=1.3.7 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/forges.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/forges.ts"
    ]
  }
}
