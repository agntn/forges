{
  "name": "@agntn/forges",
  "version": "0.5.1",
  "description": "Unified Git Provider - single TypeScript API for GitHub, GitLab, Gitea, GitBucket, and Cloudflare Artifacts",
  "keywords": [
    "api",
    "cloudflare-artifacts",
    "git",
    "gitbucket",
    "gitea",
    "github",
    "gitlab",
    "mcp",
    "omp-extension",
    "pi-package",
    "provider",
    "unified"
  ],
  "homepage": "https://forges.agntn.dev",
  "bugs": "https://github.com/agntn/forges/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/forges.git"
  },
  "bin": {
    "forges": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/shared",
    "extensions/pi",
    "extensions/omp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./local": {
      "types": "./dist/local.d.mts",
      "import": "./dist/local.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.mts",
      "import": "./dist/gitlab.mjs"
    },
    "./gitea": {
      "types": "./dist/gitea.d.mts",
      "import": "./dist/gitea.mjs"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.mts",
      "import": "./dist/artifacts.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "import": "./dist/provider.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "test": "vp test watch",
    "test:run": "vp test run",
    "test:packed": "node --experimental-strip-types test/eval-packed-extensions.mjs",
    "fmt": "vp lint --fix && vp fmt",
    "lint": "vp lint --deny-warnings && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "prepack": "obuild",
    "docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "dependencies": {
    "@agntn/credentials": "catalog:deps",
    "@agntn/hashes": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "forges": "catalog:deps",
    "unstorage": "catalog:deps"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "jiti": "catalog:dev",
    "obuild": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <2",
    "@earendil-works/pi-tui": ">=0.87.1 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.4.2 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "omp": {
    "extensions": [
      "./extensions/omp/forges.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/forges.ts"
    ],
    "image": "https://forges.agntn.dev/image.png"
  }
}
