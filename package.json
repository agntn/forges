{
  "name": "@agntn/forges",
  "version": "0.3.5",
  "description": "Unified Git Provider - single TypeScript API for GitHub, GitLab, Gitea, and GitBucket",
  "keywords": [
    "api",
    "git",
    "gitbucket",
    "gitea",
    "github",
    "gitlab",
    "mcp",
    "omp-extension",
    "pi-package",
    "provider",
    "unified"
  ],
  "homepage": "https://forges.agntn.dev",
  "bugs": "https://github.com/agntn/forges/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/forges.git"
  },
  "bin": {
    "forges": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/shared",
    "packages/pi/extensions",
    "packages/omp/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./local": {
      "types": "./dist/local.d.mts",
      "import": "./dist/local.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.mts",
      "import": "./dist/gitlab.mjs"
    },
    "./gitea": {
      "types": "./dist/gitea.d.mts",
      "import": "./dist/gitea.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "import": "./dist/provider.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test watch",
    "test:run": "vp test run",
    "test:packed": "node --experimental-strip-types test/eval-packed-extensions.mjs",
    "fmt": "vp lint --fix && vp fmt",
    "lint": "vp lint --deny-warnings && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "prepack": "vp pack",
    "release": "vp test run && vp pack && changelogen --release --push",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "0.2.2",
    "ofetch": "1.5.1",
    "typebox": "1.3.33",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oh-my-pi/omptype": "17.3.7",
    "@oh-my-pi/pi-coding-agent": "17.3.7",
    "@types/node": "24.11.2",
    "changelogen": "0.6.2",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1",
    "@earendil-works/pi-tui": ">=0.84.1 <1",
    "@oh-my-pi/pi-coding-agent": ">=17.3.7 <18",
    "typebox": ">=1.3.7 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/forges.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/forges.ts"
    ],
    "image": "https://forges.agntn.dev/image.png"
  }
}
