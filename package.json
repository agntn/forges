{
  "name": "@agntn/forges",
  "version": "0.4.1",
  "description": "Unified Git Provider - single TypeScript API for GitHub, GitLab, Gitea, GitBucket, and Cloudflare Artifacts",
  "keywords": [
    "api",
    "cloudflare-artifacts",
    "git",
    "gitbucket",
    "gitea",
    "github",
    "gitlab",
    "mcp",
    "omp-extension",
    "pi-package",
    "provider",
    "unified"
  ],
  "homepage": "https://forges.agntn.dev",
  "bugs": "https://github.com/agntn/forges/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/forges.git"
  },
  "bin": {
    "forges": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/shared",
    "packages/pi/extensions",
    "packages/omp/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./local": {
      "types": "./dist/local.d.mts",
      "import": "./dist/local.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.mts",
      "import": "./dist/gitlab.mjs"
    },
    "./gitea": {
      "types": "./dist/gitea.d.mts",
      "import": "./dist/gitea.mjs"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.mts",
      "import": "./dist/artifacts.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "import": "./dist/provider.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "test": "vp test watch",
    "test:run": "vp test run",
    "test:packed": "node --experimental-strip-types test/eval-packed-extensions.mjs",
    "fmt": "vp lint --fix && vp fmt",
    "lint": "vp lint --deny-warnings && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "prepack": "obuild",
    "release": "vp test run && obuild && changelogen --release --push",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "dependencies": {
    "@agntn/credentials": "0.0.2",
    "@agntn/hashes": "0.6.7",
    "@agntn/tools": "0.2.1",
    "@modelcontextprotocol/server": "2.2.0",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@modelcontextprotocol/client": "2.2.0",
    "@oh-my-pi/omptype": "18.4.10",
    "@oh-my-pi/pi-coding-agent": "18.4.10",
    "@types/node": "24.11.2",
    "changelogen": "0.6.2",
    "jiti": "2.7.0",
    "obuild": "0.4.43",
    "typebox": "1.3.34",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <2",
    "@earendil-works/pi-tui": ">=0.87.1 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.4.2 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.12.1",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/forges.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/forges.ts"
    ],
    "image": "https://forges.agntn.dev/image.png"
  }
}
